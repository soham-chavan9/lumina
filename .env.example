# Required
OPENAI_API_KEY=sk-your-key-here

# Environment: development | production
LUMINA_ENV=development

# Model settings
LUMINA_MODEL=gpt-4o-mini
LUMINA_EMBED_MODEL=text-embedding-3-small
LUMINA_MAX_DISTANCE=1.2

# Backend
# In production, set this to your real frontend origin(s)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
LUMINA_SEED_SAMPLE_DOCS=false

# Frontend (browser-facing API base, includes /api)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
