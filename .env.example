# Required for RAG / embeddings
OPENAI_API_KEY=sk-your-key-here

# Required in production. Protects /api/* (send as X-API-Key)
LUMINA_API_KEY=
# Browser demo only — prefer a BFF in real deployments
NEXT_PUBLIC_LUMINA_API_KEY=

# Environment: development | production
LUMINA_ENV=development

# Models
LUMINA_MODEL=gpt-4o-mini
LUMINA_EMBED_MODEL=text-embedding-3-small
LUMINA_MAX_DISTANCE=1.2

# Backend security / limits
# Production MUST set this to your real frontend origin(s)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
LUMINA_SEED_SAMPLE_DOCS=false
LUMINA_RATE_LIMIT_PER_MINUTE=120
LUMINA_LLM_RATE_LIMIT_PER_MINUTE=20
# Only true behind a reverse proxy that overwrites X-Forwarded-For
LUMINA_TRUST_PROXY=false
LUMINA_MAX_UPLOAD_MB=15
LUMINA_MAX_UPLOAD_FILES=10

# Frontend (browser-facing API base, includes /api)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Production compose ports (optional)
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
