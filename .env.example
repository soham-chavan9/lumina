# Required
OPENAI_API_KEY=sk-your-key-here

# Model settings
LUMINA_MODEL=gpt-4o-mini
LUMINA_EMBED_MODEL=text-embedding-3-small

# Backend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LUMINA_SEED_SAMPLE_DOCS=false

# Frontend (browser-facing API base, includes /api)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
